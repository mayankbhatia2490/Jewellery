# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Database & Storage (Supabase / Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_PRIVATE=jewelleray-private-vault

# Providers (Safe mock defaults for dev & test - zero paid calls)
IMAGE_PROVIDER=mock
MESSAGING_PROVIDER=mock
PAYMENT_PROVIDER=mock

# External Provider Placeholders (Optional / Staging)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Image Generation Adapters (Live Benchmarks require explicit approval)
FLUX_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
BRIA_API_KEY=

# Admin Access & Security
ADMIN_API_KEY=local-dev-admin-secret-key-change-in-prod
JWT_SECRET=local-dev-jwt-secret-key-32chars-min-length-safe
